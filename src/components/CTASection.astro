---
import Button from './Button.astro';
import Photo from './Photo.astro';
import ContactLinks from './ContactLinks.astro';

interface CTA {
	text: string;
	href: string;
	variant?: 'primary' | 'gray' | 'outline';
}

interface Props {
	id: string;
	eyebrow?: string;
	headingFirst: string;
	headingSecond: string;
	subtitle: string;
	primaryCta: CTA;
	secondaryCta?: CTA;
	image?: ImageMetadata;
	showContact?: boolean;
}

const { id, eyebrow, headingFirst, headingSecond, subtitle, primaryCta, secondaryCta, image, showContact = true } = Astro.props;
---

<section class:list={['final-cta', { 'has-image': Boolean(image) }]} id={id} aria-labelledby={`${id}-title`}>
	{image && <Photo class="final-cta__image" src={image} alt="" widths={[640, 1200]} sizes="100vw" quality={65} />}
	{image && <div class="final-cta__overlay" aria-hidden="true"></div>}
	<div class="container final-cta__inner reveal">
		{eyebrow && <p class="eyebrow">{eyebrow}</p>}
		<h2 id={`${id}-title`}>{headingFirst}<br /><em>{headingSecond}</em></h2>
		<p>{subtitle}</p>
		<div class="hero__actions">
			<Button href={primaryCta.href} variant={primaryCta.variant ?? 'primary'}>
				{primaryCta.text}<span aria-hidden="true">↗</span>
			</Button>
			{secondaryCta && (
				<Button href={secondaryCta.href} variant={secondaryCta.variant ?? 'outline'}>
					{secondaryCta.text}<span aria-hidden="true">↓</span>
				</Button>
			)}
		</div>
		{showContact && <ContactLinks variant="list" class="final-cta__contact" />}
	</div>
</section>