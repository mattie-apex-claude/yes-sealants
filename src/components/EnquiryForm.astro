---
// Adapted from the Simply-Bespoke QuoteForm (layout, validation, loading/success/error UX).
import { site } from '../data/site';
---

<div
  class="qf-wrapper"
  id="quote-form-wrapper"
  data-webhook={site.enquiryWebhook}
  data-phone={site.phoneDisplay}
  data-phone-href={site.phoneHref}
  data-email={site.email}
  data-email-href={site.emailHref}
>

  <form class="qf" id="quote-form" novalidate aria-describedby="qf-privacy">

    <!-- Row 1: Name + Mobile -->
    <div class="qf__row">
      <div class="qf__field">
        <label for="qf-name" class="qf__label">
          Name <span class="qf__req" aria-label="required">*</span>
        </label>
        <input
          type="text" id="qf-name" name="full_name"
          class="qf__input" required maxlength="80"
          autocomplete="name" placeholder="Your name"
        />
        <span class="qf__error" id="qf-name-err" role="alert" aria-live="polite"></span>
      </div>
      <div class="qf__field">
        <label for="qf-mobile" class="qf__label">
          Mobile <span class="qf__req" aria-label="required">*</span>
        </label>
        <input
          type="tel" id="qf-mobile" name="mobile"
          class="qf__input" required maxlength="20" inputmode="tel"
          autocomplete="tel" placeholder="e.g. 07950 586517"
        />
        <span class="qf__error" id="qf-mobile-err" role="alert" aria-live="polite"></span>
      </div>
    </div>

    <!-- Row 2: Postcode + House number -->
    <div class="qf__row">
      <div class="qf__field">
        <label for="qf-postcode" class="qf__label">
          Postcode <span class="qf__req" aria-label="required">*</span>
        </label>
        <input
          type="text" id="qf-postcode" name="postcode"
          class="qf__input" required maxlength="9" autocapitalize="characters"
          autocomplete="postal-code" placeholder="e.g. BD1 1AA"
        />
        <span class="qf__error" id="qf-postcode-err" role="alert" aria-live="polite"></span>
      </div>
      <div class="qf__field">
        <label for="qf-house" class="qf__label">
          House number <span class="qf__req" aria-label="required">*</span>
        </label>
        <input
          type="text" id="qf-house" name="house_number"
          class="qf__input" required maxlength="30"
          autocomplete="off" placeholder="Number or house name"
        />
        <span class="qf__error" id="qf-house-err" role="alert" aria-live="polite"></span>
      </div>
    </div>

    <!-- Project details -->
    <div class="qf__field">
      <label for="qf-desc" class="qf__label">
        Details about the project <span class="qf__req" aria-label="required">*</span>
      </label>
      <textarea
        id="qf-desc" name="project_details"
        class="qf__textarea" rows="5" required maxlength="2000"
        placeholder="Which service you need, what needs sealing and any timings..."
      ></textarea>
      <span class="qf__error" id="qf-desc-err" role="alert" aria-live="polite"></span>
    </div>

    <!-- Honeypot: real visitors never see or fill this -->
    <div class="qf__trap" aria-hidden="true">
      <label>Leave this field empty<input type="text" name="company_website" tabindex="-1" autocomplete="off" /></label>
    </div>

    <!-- Submit -->
    <div class="qf__submit-row">
      <button type="submit" class="button button--primary qf__submit" id="qf-submit">
        <span class="qf__label-text">Send enquiry <span aria-hidden="true">↗</span></span>
        <span class="qf__loading" hidden aria-hidden="true">
          <svg class="qf__spinner" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path stroke-dasharray="50" stroke-dashoffset="16" d="M12 2a10 10 0 0 1 10 10" stroke-linecap="round"/>
          </svg>
          Sending...
        </span>
      </button>
      <p class="qf__req-note" aria-hidden="true"><span class="qf__req">*</span> Required fields</p>
    </div>

    <p class="qf__privacy" id="qf-privacy">
      By sending this enquiry you agree to us using your details to respond to you, as explained in our{' '}<a class="text-link" href="/privacy-policy">Privacy Policy</a>.
    </p>

  </form>

  <!-- Success state -->
  <div class="qf__success" id="qf-success" hidden role="status" aria-live="polite" tabindex="-1">
    <div class="qf__success-icon" aria-hidden="true">✓</div>
    <h3>Enquiry received</h3>
    <p>Thank you. We’ll be in touch shortly to discuss your quote.</p>
    <p>
      For urgent enquiries call
      <a class="text-link" href={site.phoneHref}>{site.phoneDisplay}</a>
      or <a class="text-link" href={site.whatsappHref} target="_blank" rel="noopener noreferrer">message us on WhatsApp</a>.
    </p>
  </div>

  <!-- Submission error state -->
  <div class="qf__form-error" id="qf-form-error" hidden role="alert" aria-live="assertive" tabindex="-1">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
    </svg>
    <p id="qf-form-error-msg">Something went wrong. Please try again.</p>
  </div>

</div>

<script>
(function () {
  const wrapper    = document.getElementById('quote-form-wrapper') as HTMLElement | null;
  const form       = document.getElementById('quote-form') as HTMLFormElement | null;
  const submitBtn  = document.getElementById('qf-submit') as HTMLButtonElement | null;
  const successEl  = document.getElementById('qf-success') as HTMLElement | null;
  const formErrEl  = document.getElementById('qf-form-error') as HTMLElement | null;
  const formErrMsg = document.getElementById('qf-form-error-msg') as HTMLElement | null;

  if (!wrapper || !form || !submitBtn) return;

  // GoHighLevel inbound webhook (set in src/data/site.ts). The URL is the only identifier; no API keys are used.
  const WEBHOOK_URL = wrapper.dataset.webhook ?? '';
  const PHONE = wrapper.dataset.phone ?? '';
  const PHONE_HREF = wrapper.dataset.phoneHref ?? '';
  const EMAIL = wrapper.dataset.email ?? '';
  const EMAIL_HREF = wrapper.dataset.emailHref ?? '';

  let submitting = false;

  // ── Validators ────────────────────────────────────────────────────────────
  const MOBILE_RE   = /^(?:\+44|0044|0)7\d{9}$/;
  const POSTCODE_RE = /^[A-Z]{1,2}\d[A-Z\d]?\s?\d[A-Z]{2}$/i;

  function el<T extends HTMLElement>(id: string) {
    return document.getElementById(id) as T | null;
  }

  function fieldErr(fieldId: string, msg: string) {
    const input = el<HTMLInputElement>(fieldId);
    const span  = el(fieldId + '-err');
    input?.classList.add('has-error');
    input?.setAttribute('aria-invalid', 'true');
    if (span) span.textContent = msg;
  }

  function clearErr(fieldId: string) {
    const input = el<HTMLInputElement>(fieldId);
    const span  = el(fieldId + '-err');
    input?.classList.remove('has-error');
    input?.removeAttribute('aria-invalid');
    if (span) span.textContent = '';
  }

  function formatPostcode(value: string) {
    const compact = value.toUpperCase().replace(/\s+/g, '');
    return compact.length > 3 ? `${compact.slice(0, -3)} ${compact.slice(-3)}` : compact;
  }

  function validateField(id: string): boolean {
    const val = (el<HTMLInputElement>(id)?.value ?? '').trim();
    clearErr(id);
    switch (id) {
      case 'qf-name':
        if (!val)           return fieldErr(id, 'Please enter your name.'), false;
        if (val.length < 2) return fieldErr(id, 'Name must be at least 2 characters.'), false;
        break;
      case 'qf-mobile':
        if (!val) return fieldErr(id, 'Please enter your mobile number.'), false;
        if (!MOBILE_RE.test(val.replace(/[\s\-().]/g, ''))) return fieldErr(id, 'Please enter a valid UK mobile number, like 07950 586517.'), false;
        break;
      case 'qf-postcode':
        if (!val) return fieldErr(id, 'Please enter your postcode.'), false;
        if (!POSTCODE_RE.test(val)) return fieldErr(id, 'Please enter a valid UK postcode (e.g. BD1 1AA).'), false;
        break;
      case 'qf-house':
        if (!val) return fieldErr(id, 'Please enter your house number or name.'), false;
        break;
      case 'qf-desc':
        if (!val) return fieldErr(id, 'Please tell us about the project.'), false;
        if (val.length < 10) return fieldErr(id, 'Please add a little more detail (at least 10 characters).'), false;
        break;
    }
    return true;
  }

  function validateAll(): boolean {
    const fields = ['qf-name', 'qf-mobile', 'qf-postcode', 'qf-house', 'qf-desc'];
    let ok = true;
    fields.forEach(id => { if (!validateField(id)) ok = false; });
    if (!ok) {
      const first = form!.querySelector<HTMLElement>('[aria-invalid]');
      first?.scrollIntoView({ behavior: 'smooth', block: 'center' });
      first?.focus({ preventScroll: true });
    }
    return ok;
  }

  // ── Live validation ────────────────────────────────────────────────────────
  form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>(
    'input:not([name=company_website]), textarea'
  ).forEach(input => {
    input.addEventListener('blur', () => {
      if (input.id === 'qf-postcode' && POSTCODE_RE.test(input.value.trim())) input.value = formatPostcode(input.value);
      if (input.value.trim() || input.classList.contains('has-error')) validateField(input.id);
    });
    input.addEventListener('input', () => {
      if (input.classList.contains('has-error')) validateField(input.id);
    });
  });

  // ── Submit state helpers ───────────────────────────────────────────────────
  function setBusy(busy: boolean) {
    if (!submitBtn) return;
    const label   = submitBtn.querySelector<HTMLElement>('.qf__label-text');
    const loading = submitBtn.querySelector<HTMLElement>('.qf__loading');
    submitBtn.disabled = busy;
    submitBtn.setAttribute('aria-busy', String(busy));
    if (label)   label.hidden   = busy;
    if (loading) loading.hidden = !busy;
  }

  function showSuccess() {
    if (form) form.hidden = true;
    if (formErrEl) formErrEl.hidden = true;
    if (successEl) {
      successEl.hidden = false;
      successEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
      successEl.focus({ preventScroll: true });
    }
  }

  function showFormError(html: string) {
    if (formErrMsg) formErrMsg.innerHTML = html;
    if (formErrEl) {
      formErrEl.hidden = false;
      formErrEl.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }
  }

  const fallbackContact = `Please try again, or call <a href="${PHONE_HREF}">${PHONE}</a> or email <a href="${EMAIL_HREF}">${EMAIL}</a>.`;

  // ── Submit ─────────────────────────────────────────────────────────────────
  form.addEventListener('submit', async e => {
    e.preventDefault();
    if (submitting) return;
    if (formErrEl) formErrEl.hidden = true;

    const trap = form.elements.namedItem('company_website') as HTMLInputElement | null;
    if (trap?.value) { showSuccess(); return; }

    if (!validateAll()) return;

    if (!WEBHOOK_URL) {
      console.warn('[EnquiryForm] No webhook URL configured (src/data/site.ts).');
      showFormError(`<strong>Online enquiries aren’t available right now.</strong> Please call <a href="${PHONE_HREF}">${PHONE}</a> or email <a href="${EMAIL_HREF}">${EMAIL}</a>.`);
      return;
    }

    submitting = true;
    setBusy(true);

    try {
      const fd = new FormData(form);
      const text = (key: string) => ((fd.get(key) as string) ?? '').trim();
      const payload = {
        fullName:       text('full_name'),
        phone:          text('mobile'),
        postcode:       formatPostcode(text('postcode')),
        houseNumber:    text('house_number'),
        projectDetails: text('project_details'),
        source:         'Yes Sealants Website',
        pageUrl:        window.location.href,
      };

      const res = await fetch(WEBHOOK_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });

      if (res.ok) {
        showSuccess();
      } else {
        console.error('[EnquiryForm] Webhook responded with status', res.status);
        showFormError(`<strong>Your enquiry didn’t send (error ${res.status}).</strong> ${fallbackContact}`);
      }
    } catch (error) {
      console.error('[EnquiryForm]', error);
      showFormError(`<strong>We couldn’t send your enquiry.</strong> Check your connection. ${fallbackContact}`);
    } finally {
      submitting = false;
      setBusy(false);
    }
  });
})();
</script>

<style>
  .qf-wrapper { width: 100%; }

  .qf { display: flex; flex-direction: column; gap: 1.5rem; }
  .qf__row { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; }
  .qf__field { display: flex; flex-direction: column; min-width: 0; }

  .qf__label {
    display: block;
    margin-bottom: .5rem;
    color: var(--brand);
    font-size: .75rem;
    font-weight: 800;
    letter-spacing: .09em;
    text-transform: uppercase;
  }
  .qf__req { color: var(--gunmetal); }

  .qf__input,
  .qf__textarea {
    display: block;
    width: 100%;
    min-height: 52px;
    padding: .8rem 1rem;
    border: 1.5px solid var(--silver);
    border-radius: 4px;
    background: var(--off-white);
    color: var(--brand);
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.5;
    transition: border-color .18s ease, box-shadow .18s ease;
    -webkit-appearance: none;
    appearance: none;
  }
  .qf__input::placeholder,
  .qf__textarea::placeholder { color: var(--muted); font-size: .9rem; opacity: .85; }
  .qf__input:hover, .qf__textarea:hover { border-color: var(--gunmetal); }
  .qf__input:focus, .qf__textarea:focus {
    outline: none;
    border-color: var(--brand);
    box-shadow: 0 0 0 3px rgba(154, 154, 154, .45);
  }
  .qf__input.has-error, .qf__textarea.has-error {
    border-color: #a32020;
    box-shadow: 0 0 0 3px rgba(163, 32, 32, .1);
  }
  .qf__textarea { min-height: 150px; resize: vertical; }

  .qf__error { min-height: 1em; margin-top: .35rem; color: #a32020; font-size: .8rem; font-weight: 700; line-height: 1.4; }

  .qf__trap { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }

  .qf__submit-row { display: flex; align-items: center; flex-wrap: wrap; gap: 1rem 1.5rem; margin-top: .5rem; }
  .qf__submit { min-width: 220px; cursor: pointer; }
  .qf__submit:disabled { opacity: .7; cursor: progress; transform: none !important; box-shadow: none !important; }
  .qf__label-text, .qf__loading { display: inline-flex; align-items: center; gap: 16px; }
  .qf__loading { gap: 10px; }
  .qf__label-text[hidden], .qf__loading[hidden] { display: none; }
  .qf__req-note { margin: 0; color: var(--muted); font-size: .8rem; }
  .qf__privacy { margin: -.25rem 0 0; color: var(--muted); font-size: .85rem; line-height: 1.55; }

  .qf__spinner { display: inline-block; animation: qf-spin .7s linear infinite; }
  @keyframes qf-spin { to { transform: rotate(360deg); } }

  .qf__success[hidden], .qf__form-error[hidden] { display: none !important; }

  .qf__success {
    padding: 2.5rem 2rem;
    border: 1px solid var(--silver);
    border-radius: 6px;
    background: var(--light-gray);
    text-align: center;
  }
  .qf__success:focus, .qf__form-error:focus { outline: none; }
  .qf__success-icon {
    display: flex; align-items: center; justify-content: center;
    width: 52px; height: 52px; margin: 0 auto 1.25rem;
    border: 1px solid var(--silver);
    border-radius: 50%;
    background: var(--brand);
    color: var(--off-white);
    font-size: 1.4rem; font-weight: 800;
  }
  .qf__success h3 { margin-bottom: .5rem; font-size: 1.5rem; }
  .qf__success p { max-width: 44ch; margin: .4rem auto 0; color: var(--charcoal); }

  .qf__form-error {
    display: flex; align-items: flex-start; gap: .75rem;
    margin-top: 1rem; padding: 1rem 1.25rem;
    border: 2px solid #a32020; border-radius: 4px;
    background: #fbf3f3; color: #7a1717;
  }
  .qf__form-error svg { flex-shrink: 0; margin-top: .15rem; }
  .qf__form-error p { margin: 0; color: inherit; font-size: .9rem; line-height: 1.5; }
  .qf__form-error :global(a) { font-weight: 800; text-decoration: underline; text-underline-offset: 3px; }

  @media (max-width: 599px) {
    .qf__row { grid-template-columns: 1fr; }
    .qf__submit-row { flex-direction: column; align-items: stretch; }
    .qf__submit { width: 100%; min-width: 0; }
    .qf__success { padding: 2rem 1.25rem; }
  }
</style>
