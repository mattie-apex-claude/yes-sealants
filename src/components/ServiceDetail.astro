---
import Button from './Button.astro';
import Photo from './Photo.astro';

interface Service {
	slug: string;
	title: string;
	label: string;
	detail: string;
	applications: string[];
	detailImage: ImageMetadata;
	alt: string;
}

interface Props {
	service: Service;
	index: number;
}

const { service, index } = Astro.props;
---

<section class:list={['service-detail', { 'service-detail--reverse': index % 2 === 1, 'service-detail--gray': index % 2 === 1 }]} id={service.slug} aria-labelledby={`${service.slug}-title`}>
	<div class="service-detail__inner">
		<div class="service-detail__image reveal-mask">
			<Photo src={service.detailImage} alt={service.alt} sizes="(max-width: 760px) 100vw, 600px" />
		</div>
		<div class="service-detail__copy reveal">
			<p class="eyebrow">{service.label}</p>
			<h2 id={`${service.slug}-title`}>{service.title}</h2>
			<p class="service-detail__description">{service.detail}</p>
			<ul>
				{service.applications.map((application) => <li>{application}</li>)}
			</ul>
			<Button href="/contact" variant="primary">Enquire about {service.title} <span aria-hidden="true">↗</span></Button>
		</div>
	</div>
</section>

<style>
	.service-detail { padding: clamp(48px, 6vw, 76px) var(--gutter); background: var(--off-white); }
	.service-detail--gray { background: var(--light-gray); }
	.service-detail__inner { width: min(100%, var(--container)); display: grid; grid-template-columns: 1fr 1fr; align-items: center; gap: clamp(32px, 6vw, 76px); margin-inline: auto; }
	.service-detail--reverse .service-detail__image { order: 2; }
	.service-detail__image { min-height: 360px; overflow: hidden; border: 1px solid var(--silver-soft); border-radius: 7px; background: var(--rule); }
	.service-detail__image img { width: 100%; height: 100%; min-height: 360px; object-fit: cover; }
	.service-detail__copy { max-width: 580px; }
	.service-detail__copy h2 { margin-bottom: 18px; }
	.service-detail__description { max-width: 55ch; color: var(--charcoal); font-size: 16px; }
	.service-detail__copy ul { display: grid; grid-template-columns: 1fr 1fr; gap: 10px 18px; margin: 22px 0 28px; padding: 0; list-style: none; }
	.service-detail__copy li { position: relative; padding-left: 22px; color: var(--muted); font-size: 13px; }
	.service-detail__copy li::before { position: absolute; top: .8em; left: 0; width: 10px; height: 1px; background: var(--gunmetal); content: ''; }
	@media (max-width: 760px) {
		.service-detail__inner { grid-template-columns: 1fr; gap: 26px; }
		.service-detail--reverse .service-detail__image { order: 0; }
		.service-detail__image, .service-detail__image img { min-height: 0; height: 58vw; max-height: 440px; }
	}
	@media (max-width: 480px) { .service-detail__copy ul { grid-template-columns: 1fr; } }
</style>