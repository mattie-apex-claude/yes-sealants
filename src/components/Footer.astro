---
import Photo from './Photo.astro';
import ContactLinks from './ContactLinks.astro';
import { photo, services } from '../data/siteContent';
import { site } from '../data/site';

const logo = photo('logo', 'yes-sealants-wide.jpg');
---

<footer class="site-footer">
	<div class="container footer__main">
		<div class="footer__brand">
			<a class="brand brand--footer" href="/" aria-label="Yes Sealants home"><Photo src={logo} alt="Yes Sealants, established 2025" widths={[190, 380]} sizes="164px" quality={85} /></a>
			<p>Mastic and silicone sealing for homeowners, contractors and commercial projects. {site.areaLine}</p>
			<ContactLinks variant="socials" class="footer__socials" />
		</div>
		<nav class="footer__col" aria-label="Services">
			<h2>Services</h2>
			<ul>
				{services.map((service) => <li><a href={`/services#${service.slug}`}>{service.title}</a></li>)}
			</ul>
		</nav>
		<nav class="footer__col" aria-label="Company">
			<h2>Company</h2>
			<ul>
				<li><a href="/#quality">About us</a></li>
				<li><a href="/our-work">Our work</a></li>
				<li><a href="/areas-we-cover">Areas we cover</a></li>
				<li><a href="/contact">Get a quote</a></li>
			</ul>
		</nav>
		<div class="footer__col footer__col--contact">
			<h2>Contact</h2>
			<ContactLinks variant="list" socials={false} />
		</div>
	</div>
	<div class="container footer__bottom">
		<span>© {new Date().getFullYear()} Yes Sealants</span>
		<nav class="footer__legal" aria-label="Legal">
			<a href="/privacy-policy">Privacy policy</a>
			<a href="/cookie-policy">Cookie policy</a>
		</nav>
		<span>Website by <a href="https://apexflow.co.uk/" target="_blank" rel="noopener noreferrer">Apexflow</a></span>
	</div>
</footer>

<style>
	.site-footer { padding: 56px 0 20px; border-top: 1px solid var(--silver); background: var(--brand); color: var(--off-white); }
	.footer__main { display: grid; grid-template-columns: 1.4fr .8fr .8fr 1.2fr; align-items: start; gap: 40px; padding-bottom: 44px; }
	.brand--footer { display: block; width: 164px; }
	.brand--footer img { width: 100%; height: 70px; object-fit: contain; filter: invert(1); mix-blend-mode: screen; }
	.footer__brand p { max-width: 320px; margin-top: 14px; color: rgba(255, 255, 255, .72); font-size: 14px; line-height: 1.6; }
	.footer__brand :global(.footer__socials) { margin-top: 12px; }
	.footer__col h2 { margin: 0 0 14px; color: var(--silver); font-family: var(--font-body); font-size: 11px; font-weight: 800; letter-spacing: .08em; line-height: 1.2; text-transform: uppercase; }
	.footer__col ul { display: grid; gap: 0; margin: 0; padding: 0; list-style: none; }
	.footer__col ul:not(.contact-links) a { display: inline-flex; align-items: center; min-height: 44px; font-size: 14px; font-weight: 600; }
	.footer__col a, .footer__bottom a { transition: color var(--motion); }
	.footer__col a:hover, .footer__bottom a:hover { color: var(--silver); text-decoration: underline; text-underline-offset: 4px; }
	.footer__col--contact { min-width: 0; overflow-wrap: anywhere; }
	.footer__bottom { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 8px 16px; padding-top: 18px; border-top: 1px solid var(--gunmetal); color: rgba(255, 255, 255, .62); font-size: 12px; }
	.footer__legal { display: flex; flex-wrap: wrap; gap: 4px 18px; }
	.footer__bottom a { display: inline-flex; align-items: center; min-height: 44px; color: var(--off-white); font-weight: 700; }
	@media (max-width: 960px) {
		.footer__main { grid-template-columns: 1fr 1fr 1fr; gap: 32px 24px; }
		.footer__brand { grid-column: 1 / -1; }
	}
	@media (max-width: 720px) {
		.site-footer { padding-top: 44px; }
		.footer__main { grid-template-columns: 1fr 1fr; }
		.footer__col--contact { grid-column: 1 / -1; }
		.footer__bottom { flex-direction: column; align-items: flex-start; }
	}
</style>
