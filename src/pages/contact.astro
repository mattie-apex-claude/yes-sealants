---
import Layout from '../layouts/Layout.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import ContactLinks from '../components/ContactLinks.astro';
import { breadcrumbSchema } from '../data/schema';
import { site } from '../data/site';

const contactSchema = {
	'@context': 'https://schema.org',
	'@type': 'ContactPage',
	name: 'Contact Yes Sealants',
	url: `${site.url}/contact`,
	about: { '@id': `${site.url}/#business` },
};
---

<Layout
	title="Contact Yes Sealants | Get a Sealant Quote in Bradford"
	description="Request a quote from Yes Sealants, a Bradford sealant specialist covering West Yorkshire and surrounding areas. Call, WhatsApp, email or send an enquiry online."
	schema={[breadcrumbSchema([{ name: 'Home', path: '/' }, { name: 'Contact', path: '/contact' }]), contactSchema]}
>
	<section class="page-intro" aria-labelledby="contact-title">
		<div class="container page-intro__inner reveal">
			<p class="eyebrow eyebrow--light">Contact</p>
			<h1 id="contact-title">Get a<br /><span>quote.</span></h1>
			<p>Tell us what needs sealing and where the work is. {site.areaLine} {site.outOfAreaLine}</p>
		</div>
	</section>

	<section class="contact-section" aria-labelledby="enquiry-title">
		<div class="container contact-layout">
			<div class="contact-form reveal">
				<h2 id="enquiry-title">Send an enquiry</h2>
				<p class="contact-form__intro">Fill in the form and we’ll get back to you. Homeowners, contractors and commercial clients are all welcome.</p>
				<EnquiryForm />
			</div>
			<aside class="contact-details reveal" aria-labelledby="contact-details-title">
				<h2 id="contact-details-title">Prefer to talk?</h2>
				<p>Call, message or email us directly.</p>
				<ContactLinks variant="list" socials={false} />
				<hr />
				<h3>Where we work</h3>
				<p>{site.areaLine} {site.outOfAreaLine}</p>
				<p><a class="text-link" href="/areas-we-cover">See the areas we cover</a> or <a class="text-link" href="/services">view our services</a>.</p>
				<hr />
				<h3>Follow Yes Sealants</h3>
				<ContactLinks variant="socials" />
			</aside>
		</div>
	</section>
</Layout>

<style>
	.contact-section { padding-block: clamp(36px, 5vw, 64px); background: var(--off-white); }
	.contact-layout { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, .75fr); align-items: start; gap: clamp(28px, 5vw, 64px); }
	.contact-form h2, .contact-details h2 { margin-bottom: 10px; font-size: clamp(26px, 2.8vw, 36px); }
	.contact-form__intro { max-width: 52ch; margin-bottom: 26px; color: var(--muted); font-size: 15px; }
	.contact-details { padding: clamp(22px, 3vw, 34px); border: 1px solid var(--silver-soft); border-radius: 7px; background: var(--light-gray); }
	.contact-details > p { margin-bottom: 14px; color: var(--charcoal); font-size: 15px; }
	.contact-details hr { height: 1px; margin: 22px 0; border: 0; background: var(--metal-line); opacity: .6; }
	.contact-details h3 { margin-bottom: 8px; font-size: 18px; }
	.contact-details :global(.contact-links--list a) { overflow-wrap: anywhere; }
	@media (max-width: 900px) { .contact-layout { grid-template-columns: 1fr; } }
</style>
